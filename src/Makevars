PKG_CPPFLAGS = \
-std=c++14 \
-isystem ../.pixi/envs/default/include \
-I ../thirdParty/cget/include \
-I ../thirdParty/cget/lib \
-I ../thirdParty/cget/lib64 \
-D SQLITE_ENABLE_COLUMN_METADATA -O3 -fpic -Wall -Wextra -pedantic  -DARMA_64BIT_WORD=1 -D__STDC_FORMAT_MACROS -fopenmp -O3

CXX_STD = CXX14

# Some conda-forge macOS R builds retain a stale -lheapt_w entry in FLIBS
# after the Fortran runtime is upgraded. CASTIE has no Fortran sources, and
# its BLAS/LAPACK libraries are linked dynamically, so that wrapper is not
# needed. Keep the remaining R-provided Fortran runtime flags.
CASTIE_FLIBS = $(filter-out -lheapt_w,$(FLIBS))
PKG_LIBS = $(ZLIB_LIB) $(LAPACK_LIBS) $(BLAS_LIBS) $(CASTIE_FLIBS) -L../thirdParty/cget/lib/ -L../thirdParty/cget/lib64/ -lsuperlu -lzstd -L../lib64 -llapack -fopenmp
PKG_LIBS += $(shell ${R_HOME}/bin/Rscript -e "RcppParallel::RcppParallelLibs()")


OBJECTS = RcppExports.o GENO_null.o getMem.o VCF.o BGEN.o PLINK.o SAIGE_test.o SPA_binary.o SPA.o SPA_survival.o UTIL.o Main.o test.o CCT.o Binary_HyperGeo.o Binary_ComputeExact.o Binary_global.o Binary_ComputeExactSKATO.o Binary_resampling.o Binary_Permu_SKAT.o ER_binary_func.o LDmat.o SKAT_funcs.o qfc.o

all: $(SHLIB)
$(SHLIB): ${OBJECTS} Makevars
